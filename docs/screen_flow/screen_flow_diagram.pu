@startuml screen_flow_vizshare
skinparam defaultFontName "Noto Sans CJK JP"
hide empty description

title Vizshare Screen Flow (MVP)

legend left
#LightBlue (Blue): Main screens
#LightYellow (Yellow): Display screens
end legend

[*] --> home

state "Home Screen" as home #LightBlue
state "Dataset Management Screen\n(My Datasets & Upload)\n(login required)" as datasetManagement #LightBlue
state "Public Datasets Screen\n(Latest Public Datasets)" as publicDatasets #LightYellow
state "Dataset Page\n(Graph View & Dataset Details)" as datasetView #LightYellow

home --> datasetManagement : My datasets
home --> publicDatasets : Browse public datasets

datasetManagement --> datasetView : Select dataset
publicDatasets --> datasetView : Select dataset

datasetView --> datasetManagement : Back (owner view)
datasetView --> publicDatasets : Back (public view)

@enduml